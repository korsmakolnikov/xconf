;; Antracite bar for i3 — same modules the old i3bar + i3status showed.

(deflisten workspaces :initial "[]" "~/.config/eww/scripts/i3-listen.py workspaces")
(deflisten mode :initial "" "~/.config/eww/scripts/i3-listen.py mode")

(defpoll wifi     :interval "5s"  :initial "{\"up\":false}"      "~/.config/eww/scripts/status.py wifi")
(defpoll ethernet :interval "5s"  :initial "{\"up\":false}"      "~/.config/eww/scripts/status.py ethernet")
(defpoll battery  :interval "10s" :initial "{\"present\":false,\"capacity\":100,\"status\":\"\",\"remaining\":\"\"}" "~/.config/eww/scripts/status.py battery")
(defpoll ipv4     :interval "10s" :initial "{\"addr\":\"\"}"     "~/.config/eww/scripts/status.py ipv4")
(defpoll loadavg  :interval "5s"  "cut -d' ' -f1 /proc/loadavg")
(defpoll clock    :interval "1s"  "date '+%Y-%m-%d %H:%M:%S'")

(defwidget pill [?class]
  (box :class "pill ${class}" :space-evenly false :spacing 6
    (children)))

(defwidget item [icon text ?class ?tooltip]
  (box :class "item ${class}" :space-evenly false :spacing 6 :tooltip tooltip
    (label :class "icon" :text icon)
    (label :class "text" :text text)))

(defwidget workspaces []
  (eventbox :onscroll "i3-msg -q workspace $([ {} = up ] && echo prev_on_output || echo next_on_output)"
    (box :class "pill workspaces" :space-evenly false :spacing 4
      (for ws in workspaces
        (button :class "ws ${ws.focused ? 'focused' : ws.visible ? 'visible' : ''} ${ws.urgent ? 'urgent' : ''}"
                :onclick "i3-msg -q 'workspace \"${ws.name}\"'"
          (label :text "${ws.name}"))))))

(defwidget binding-mode []
  (revealer :transition "slideright" :reveal {mode != ""} :duration "200ms"
    (box :class "pill mode" (label :text mode))))

(defwidget status []
  (box :class "status" :space-evenly false :spacing 8 :halign "end"
    (pill
      (item :class {ipv4.addr == "" ? "dim" : ""} :icon "󰩟"
            :text {ipv4.addr == "" ? "offline" : ipv4.addr})
      (item :class {wifi.up ? "" : "crit"} :icon {wifi.up ? "󰤨" : "󰤭"}
            :text {wifi.up ? "${wifi.quality}% ${wifi.ssid}" : "down"}
            :tooltip {wifi.up ? wifi.ip : ""})
      (box :visible {ethernet.up}
        (item :icon "󰈀" :text "${ethernet.ip} (${ethernet.speed})")))
    (pill
      (item :class {battery.capacity < 15 && battery.status != "Charging" ? "crit" : battery.capacity < 30 ? "warn" : ""}
            :icon {battery.status == "Charging" ? "󰂄" : battery.capacity > 60 ? "󰁹" : battery.capacity > 25 ? "󰁾" : "󰁺"}
            :text "${battery.capacity}%${battery.remaining == '' ? '' : ' ' + battery.remaining}"
            :tooltip {battery.status}))
    (pill
      (item :icon "󰋊" :text "${round(EWW_DISK['/'].free / 1073741824, 1)}G")
      (item :icon "󰻠"  :text loadavg)
      (item :class {EWW_RAM.available_mem < 1073741824 ? "warn" : ""} :icon "󰍛"
            :text "${round(EWW_RAM.used_mem / 1073741824, 1)}G | ${round(EWW_RAM.available_mem / 1073741824, 1)}G"))
    (pill :class "tray"
      (systray :spacing 8 :icon-size 22 :prepend-new true))))

(defwidget bar []
  (centerbox :class "bar"
    (box :space-evenly false :spacing 8 :halign "start"
      (workspaces)
      (binding-mode))
    (pill :class "clock"
      (item :icon "󰥔" :text clock))
    (status)))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%" :y "0px" :width "100%" :height "64px" :anchor "bottom center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  :reserve (struts :distance "64px" :side "bottom")
  (bar))
