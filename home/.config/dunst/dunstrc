# Antracite: same palette and radius as the eww bar (~/.config/eww/eww.scss).
# Notifications stack top right, 10px from the edges like the i3 gaps.

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (10, 10)          # the eww bar is at the bottom: same 10px as the gaps
    width = (300, 420)
    height = (0, 220)
    gap_size = 8
    notification_limit = 5
    indicate_hidden = yes

    font = JetBrainsMono Nerd Font 12
    markup = full
    format = "<span foreground='#8a9498' size='small'>%a</span>\n<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    show_age_threshold = 60

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14
    frame_width = 1
    corner_radius = 14
    separator_height = 1
    separator_color = frame
    transparency = 0

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4

    history_length = 20
    sort = yes
    idle_threshold = 120
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#23292b"
    foreground = "#8a9498"
    frame_color = "#383e42"
    highlight = "#8ea5b2"
    timeout = 8

[urgency_normal]
    background = "#23292b"
    foreground = "#d6dadb"
    frame_color = "#383e42"
    highlight = "#e05bbf"
    timeout = 10

[urgency_critical]
    background = "#23292b"
    foreground = "#d6dadb"
    frame_color = "#e0566e"
    highlight = "#e0566e"
    timeout = 0
