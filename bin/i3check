#!/usr/bin/env bash
# Report every exec/exec_always in the i3 config whose command is not on this machine.
# Checks the shared config and this host's local.conf (or the files given as arguments).
# Resolves `set $var value` variables and a leading ~; exits 1 if anything is missing.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
if (($#)); then
	configs=("$@")
else
	configs=("$repo/home/.config/i3/config")
	local_conf="$repo/hosts/${DOTLINK_HOST:-$(hostname)}/.config/i3/local.conf"
	[[ -f "$local_conf" ]] && configs+=("$local_conf")
fi
status=0

declare -A vars
while read -r _ name value; do
	vars[$name]=$value
done < <(grep -hE '^\s*set\s+\$' "${configs[@]}")

for config in "${configs[@]}"; do
	while IFS=: read -r lineno line; do
		cmd=$(sed -E 's/^\s*exec(_always)?\s+(--no-startup-id\s+)?//' <<<"$line" | awk '{print $1}')
		[[ "$cmd" == \$* ]] && cmd=$(awk '{print $1}' <<<"${vars[$cmd]:-$cmd}")
		cmd="${cmd/#\~/$HOME}"
		if ! command -v "$cmd" >/dev/null && ! [[ "$cmd" == /* && -f "$cmd" && -x "$cmd" ]]; then
			echo "missing:    $config:$lineno: $line"
			status=1
		fi
	done < <(grep -nE '^\s*exec' "$config")
done

[[ $status -eq 0 ]] && echo "ok: every i3 exec resolves"
exit $status
