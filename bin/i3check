#!/usr/bin/env bash
# Report every exec/exec_always in the i3 config whose command is not on this machine.
# Resolves `set $var value` variables and a leading ~; exits 1 if anything is missing.
set -euo pipefail

config="${1:-$(cd "$(dirname "$0")/.." && pwd)/home/.config/i3/config}"
status=0

declare -A vars
while read -r _ name value; do
	vars[$name]=$value
done < <(grep -E '^\s*set\s+\$' "$config")

while IFS=: read -r lineno line; do
	cmd=$(sed -E 's/^\s*exec(_always)?\s+(--no-startup-id\s+)?//' <<<"$line" | awk '{print $1}')
	[[ "$cmd" == \$* ]] && cmd=$(awk '{print $1}' <<<"${vars[$cmd]:-$cmd}")
	cmd="${cmd/#\~/$HOME}"
	if ! command -v "$cmd" >/dev/null && [[ ! -x "$cmd" ]]; then
		echo "missing:    $config:$lineno: $line"
		status=1
	fi
done < <(grep -nE '^\s*exec' "$config")

[[ $status -eq 0 ]] && echo "ok: every i3 exec resolves"
exit $status
